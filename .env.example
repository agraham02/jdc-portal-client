# =====================================================
# JDC Portal Client - Environment Variables Template
# =====================================================
# Copy this to .env and fill in your values.
# Environment-specific overrides go in .env.[environment]
#
# Load order (first found wins):
#   1. process.env
#   2. .env.$(NODE_ENV).local
#   3. .env.local
#   4. .env.$(NODE_ENV)
#   5. .env
# =====================================================

# =====================================================
# API Configuration
# =====================================================
# Backend API base URL (must include /api path)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# WebSocket URL for real-time notifications
# Use ws:// for local, wss:// for production
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# API request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT_MS=20000

# =====================================================
# Feature Flags
# =====================================================
NEXT_PUBLIC_ENABLE_REALTIME_NOTIFICATIONS=true
NEXT_PUBLIC_NOTIFICATION_POLL_INTERVAL=60000
NEXT_PUBLIC_DEBUG_SOCKET=false

# =====================================================
# Novu (Notifications)
# =====================================================
NEXT_PUBLIC_NOVU_APP_ID=

# =====================================================
# Observability (optional)
# =====================================================
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# =====================================================
# Production Deployment Notes
# =====================================================
# For production (.env.production):
#   NEXT_PUBLIC_API_URL=https://your-api.example.com/api
#   NEXT_PUBLIC_WS_URL=wss://your-api.example.com
#   NEXT_PUBLIC_NOVU_APP_ID=your-prod-novu-id
#
# For Vercel: Set these in Project Settings → Environment Variables