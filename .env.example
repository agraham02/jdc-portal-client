# JDC Portal Client Environment Variables

# ============================================
# API Configuration
# ============================================

# Backend API base URL (must include /api path)
# Example (local): http://localhost:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# WebSocket URL for real-time notifications
# If not set, will be derived from NEXT_PUBLIC_API_URL
# Use ws:// for local, wss:// for production
# You can also use http(s):// origins — Socket.IO will upgrade automatically
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# API request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT_MS=20000

# ============================================
# Feature Flags
# ============================================

# Enable real-time notifications via WebSocket
NEXT_PUBLIC_ENABLE_REALTIME_NOTIFICATIONS=true

# Fallback polling interval when WebSocket is unavailable (ms)
NEXT_PUBLIC_NOTIFICATION_POLL_INTERVAL=60000

# Enable verbose socket logs in the browser console (true|false)
NEXT_PUBLIC_DEBUG_SOCKET=false

# ============================================
# Development / Tooling
# ============================================

# Next.js development mode
NODE_ENV=development

# Disable Next.js telemetry locally (optional)
# https://nextjs.org/telemetry
NEXT_TELEMETRY_DISABLED=1

# ============================================
# Observability (optional)
# ============================================

# Sentry browser DSN for error tracking (optional)
# Requires setting up @sentry/nextjs. Leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=

# Auth token for uploading Sentry sourcemaps during builds (optional)
# Only needed in CI (e.g., Vercel). Do NOT commit real tokens.
SENTRY_AUTH_TOKEN=

# ============================================
# Production Notes
# ============================================
# For production deployment:
# 1. Update NEXT_PUBLIC_API_URL to your production API base with /api (e.g., https://api.example.com/api)
# 2. Set NEXT_PUBLIC_WS_URL to use wss:// and point to the same origin (e.g., wss://api.example.com)
# 3. Do NOT set NODE_ENV manually on Vercel; it is managed by the platform
# 4. Ensure CORS and cookies are configured on the backend for your frontend domain

# ============================================
# Vercel Configuration (copy these into Project Settings → Environment Variables)
# ============================================
# Scope: Production, Preview, Development (as needed)
#
# NEXT_PUBLIC_API_URL=https://YOUR_API_DOMAIN/api
# NEXT_PUBLIC_WS_URL=wss://YOUR_API_DOMAIN
# NEXT_PUBLIC_API_TIMEOUT_MS=20000
# NEXT_PUBLIC_ENABLE_REALTIME_NOTIFICATIONS=true
# NEXT_PUBLIC_NOTIFICATION_POLL_INTERVAL=60000
# NEXT_PUBLIC_DEBUG_SOCKET=false
# NEXT_PUBLIC_SENTRY_DSN= (optional)
# SENTRY_AUTH_TOKEN= (optional; for sourcemaps if Sentry is enabled)

