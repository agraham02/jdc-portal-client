# =====================================================
# JDC Portal Client - Environment Variables Template
# =====================================================
# Copy this to .env and fill in your values.
# Environment-specific overrides go in .env.[environment]
#
# Load order (first found wins):
#   1. process.env
#   2. .env.$(NODE_ENV).local
#   3. .env.local
#   4. .env.$(NODE_ENV)
#   5. .env
# =====================================================

# =====================================================
# API Configuration
# =====================================================
# Backend API base URL (must include /api path)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# API request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT_MS=20000

# =====================================================
# Novu (Notifications)
# =====================================================
# Get your Application ID from the Novu Dashboard:
# Dashboard → Settings → API Keys → Application Identifier
# Each environment (Development/Production) has its own ID
NEXT_PUBLIC_NOVU_APP_ID=your-novu-app-id

# =====================================================
# Observability (optional)
# =====================================================
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# =====================================================
# Production Deployment Notes
# =====================================================
# For production (.env.production):
#   NEXT_PUBLIC_API_URL=https://your-api.example.com/api
#   NEXT_PUBLIC_NOVU_APP_ID=your-prod-novu-app-id
#
# For Vercel: Set these in Project Settings → Environment Variables
#
# Important: Novu has separate environments (Development/Production)
# You must publish workflows from Dev → Production in the Novu Dashboard
# and use the Production environment's Application ID